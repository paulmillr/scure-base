{
  "name": "@scure/base",
  "version": "2.3.0",
  "description": "Secure, audited & 0-dep implementation of base64, bech32, base58, base32 & base16",
  "files": [
    "index.js",
    "index.d.ts",
    "index.ts"
  ],
  "devDependencies": {
    "@noble/hashes": "2.3.0",
    "@paulmillr/jsbt": "0.6.5",
    "@types/node": "25.3.0",
    "fast-check": "4.2.0",
    "prettier": "3.6.2",
    "typescript": "6.0.2"
  },
  "scripts": {
    "benchmark": "node benchmark/base.ts",
    "benchmark:thirdparty": "npm --prefix benchmark/thirdparty run benchmark",
    "benchmark:thirdparty22": "npm --prefix benchmark/thirdparty run benchmark:22",
    "benchmark:size": "npx bismar@0.1.3 -s",
    "build": "tsc",
    "check": "jsbt-check",
    "format": "prettier --write index.ts test/*.test.ts",
    "test": "node test/index.ts",
    "test:deno": "deno --allow-env --allow-read test/index.ts && deno test/deno.ts"
  },
  "keywords": [
    "bech32",
    "bech32m",
    "base64",
    "base58",
    "base32",
    "base16",
    "rfc4648",
    "rfc3548",
    "crockford",
    "encode",
    "encoder",
    "base-x",
    "base"
  ],
  "homepage": "https://paulmillr.com/noble/#scure",
  "funding": "https://paulmillr.com/funding/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulmillr/scure-base.git"
  },
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "types": "index.d.ts",
  "sideEffects": false,
  "author": "Paul Miller (https://paulmillr.com)",
  "license": "MIT"
}
